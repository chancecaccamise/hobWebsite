# Launch date/time for the countdown (ISO 8601, include a timezone offset).
NEXT_PUBLIC_LAUNCH_DATE=2027-01-01T00:00:00-05:00

# Supabase project (Dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional: Formspree endpoint that emails the owner on each contact form
# submission. Defaults to the HOB Contact Form endpoint in src/lib/formspree.ts.
# FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
